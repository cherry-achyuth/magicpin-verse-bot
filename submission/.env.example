# LLM Provider configuration for Vera Bot
# Options for LLM_PROVIDER: gemini, openai, anthropic, deepseek, groq, openrouter, ollama
LLM_PROVIDER=gemini

# Your LLM API key (leave empty if using local Ollama)
LLM_API_KEY=your_api_key_here

# Model name (optional, leave blank for provider default)
LLM_MODEL=gemini-1.5-flash
